{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": [
    "openspec/**",
    "**/dist/**",
    "**/.output/**",
    "**/.nuxt/**",
    "**/.data/**",
    "**/*.fixture.ts",
    "packages/admin/src/runtime/crystal-neuo/**"
  ],
  "rules": {
    "no-underscore-dangle": [
      "warn",
      {
        "allow": [
          "_id",
          "_version",
          "_createdAt",
          "_updatedAt",
          "__env__"
        ]
      }
    ]
  }
}
