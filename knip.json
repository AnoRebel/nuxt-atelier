{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "**/*.fixture.ts"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "test/vue-tsc/NestedSlots.vue"
      ]
    },
    "packages/*": {
      "entry": [
        "src/module.ts"
      ]
    },
    "packages/core": {
      "entry": [
        "src/runtime/*/index.ts"
      ]
    },
    "packages/layer": {},
    "docs": {
      "ignoreDependencies": [
        "@takumi-rs/core"
      ]
    },
    "test/fixtures/types": {
      "ignoreDependencies": [
        "vue-tsc"
      ]
    },
    "test/fixtures/layer-override": {
      "entry": [
        "app/components/*.vue"
      ]
    },
    "test/fixtures/schema": {
      "ignoreDependencies": [
        "vue-tsc"
      ],
      "entry": [
        "{,layers/*/}server/atelier/{collections,singletons}/*.ts",
        "{app,server}/type-checks.ts"
      ]
    }
  },
  "ignoreUnresolved": [
    "#imports",
    "#atelier-schema",
    "#atelier/server"
  ]
}
