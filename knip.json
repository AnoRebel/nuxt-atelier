{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "**/*.fixture.ts"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "test/vue-tsc/NestedSlots.vue"
      ]
    },
    "packages/*": {
      "entry": [
        "src/module.ts"
      ]
    },
    "packages/core": {
      "entry": [
        "src/runtime/*/index.ts",
        "src/cli/index.ts",
        "build.config.ts",
        "src/runtime/server/plugins/*.ts",
        "src/runtime/server/api/**/*.ts",
        "src/adapter.ts"
      ]
    },
    "packages/layer": {},
    "docs": {
      "ignoreDependencies": [
        "@takumi-rs/core"
      ]
    },
    "test/fixtures/types": {
      "ignoreDependencies": [
        "vue-tsc"
      ]
    },
    "test/fixtures/layer-override": {
      "entry": [
        "app/components/*.vue"
      ]
    },
    "test/fixtures/schema": {
      "ignoreDependencies": [
        "vue-tsc"
      ],
      "entry": [
        "{,layers/*/}server/atelier/{collections,singletons}/*.ts",
        "{app,server}/type-checks.ts"
      ]
    },
    "test/fixtures/auth": {
      "entry": [
        "server/api/**/*.ts"
      ]
    },
    "test/fixtures/pending": {
      "entry": [
        "server/atelier/collections/*.ts",
        "server/api/*.ts"
      ]
    },
    "test/fixtures/dev-migrate": {
      "entry": [
        "server/atelier/collections/*.ts"
      ]
    },
    "test/fixtures/workers": {
      "entry": [
        "server/atelier/collections/*.ts",
        "server/api/**/*.ts"
      ]
    }
  },
  "ignoreUnresolved": [
    "#imports",
    "#atelier-schema",
    "#atelier/server",
    "#atelier-migrations",
    "#atelier-drivers"
  ]
}
