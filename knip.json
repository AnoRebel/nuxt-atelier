{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "**/*.fixture.ts"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "test/vue-tsc/NestedSlots.vue"
      ]
    },
    "packages/*": {
      "entry": [
        "src/module.ts"
      ]
    },
    "packages/core": {
      "entry": [
        "src/runtime/*/index.ts",
        "src/cli/index.ts",
        "build.config.ts",
        "src/runtime/server/plugins/*.ts",
        "src/runtime/server/api/**/*.ts",
        "src/runtime/server/middleware/*.ts",
        "src/runtime/app/components/*.ts",
        "src/adapter.ts"
      ]
    },
    "packages/auth-better-auth": {
      "entry": [
        "build.config.ts",
        "src/config.ts",
        "src/runtime/server/*.ts"
      ]
    },
    "packages/layer": {},
    "docs": {
      "ignoreDependencies": [
        "@takumi-rs/core"
      ]
    },
    "test/fixtures/types": {
      "ignoreDependencies": [
        "vue-tsc"
      ]
    },
    "test/fixtures/layer-override": {
      "entry": [
        "app/components/*.vue"
      ]
    },
    "test/fixtures/schema": {
      "ignoreDependencies": [
        "vue-tsc"
      ],
      "entry": [
        "{,layers/*/}server/atelier/{collections,singletons}/*.ts",
        "{app,server}/type-checks.ts"
      ]
    },
    "test/fixtures/api": {
      "entry": [
        "app/**/*.vue",
        "server/api/**/*.ts",
        "server/atelier/**/*.ts"
      ]
    },
    "test/fixtures/auth": {
      "entry": [
        "server/api/**/*.ts",
        "server/atelier/roles.ts"
      ]
    },
    "test/fixtures/blocks": {
      "entry": [
        "app/**/*.{vue,ts}",
        "layers/base/app/blocks/*.vue",
        "server/**/*.ts"
      ]
    },
    "test/fixtures/blocks-dev": {
      "entry": [
        "app/blocks/*.vue",
        "server/**/*.ts"
      ]
    },
    "test/fixtures/better-auth": {
      "entry": [
        "server/atelier/*.ts"
      ]
    },
    "test/fixtures/passkeys": {
      "entry": [
        "server/api/**/*.ts"
      ]
    },
    "test/fixtures/pending": {
      "entry": [
        "server/atelier/collections/*.ts",
        "server/api/*.ts"
      ]
    },
    "test/fixtures/dev-migrate": {
      "entry": [
        "server/atelier/collections/*.ts"
      ]
    },
    "test/fixtures/workers": {
      "entry": [
        "server/atelier/collections/*.ts",
        "server/api/**/*.ts"
      ]
    },
    "test/fixtures/ui-shared": {
      "entry": [
        "app/**/*.vue",
        "server/**/*.ts"
      ]
    },
    "test/fixtures/ui-nuxt-ui": {
      "entry": [
        "app/**/*.{vue,ts}"
      ]
    },
    "test/fixtures/ui-shadcn": {
      "entry": [
        "app/**/*.{vue,ts}"
      ]
    },
    "test/fixtures/ui-tailwind": {
      "entry": [
        "app/**/*.{vue,ts}"
      ]
    },
    "test/fixtures/ui-css": {
      "entry": [
        "app/**/*.{vue,ts}"
      ]
    }
  },
  "ignoreUnresolved": [
    "#imports",
    "#atelier-schema",
    "#atelier/server",
    "#atelier-migrations",
    "#atelier-drivers",
    "#atelier-better-auth",
    "#atelier-blocks"
  ]
}
