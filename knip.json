{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "**/*.fixture.ts"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "test/vue-tsc/NestedSlots.vue"
      ]
    },
    "packages/*": {
      "entry": [
        "src/module.ts"
      ]
    },
    "packages/core": {
      "entry": [
        "src/runtime/*/index.ts",
        "src/cli/index.ts",
        "build.config.ts",
        "src/runtime/server/plugins/*.ts",
        "src/runtime/server/tasks/*.ts",
        "src/runtime/server/api/**/*.ts",
        "src/runtime/server/middleware/*.ts",
        "src/runtime/app/components/*.ts",
        "src/runtime/app/pages/*.ts",
        "src/adapter.ts",
        "src/storage.ts",
        "src/runtime/app/composables/*.ts"
      ]
    },
    "packages/storage-s3": {
      "entry": [
        "src/module.ts",
        "src/runtime/plugin.ts"
      ]
    },
    "packages/storage-vercel-blob": {
      "entry": [
        "src/module.ts",
        "src/runtime/plugin.ts"
      ]
    },
    "packages/auth-better-auth": {
      "entry": [
        "build.config.ts",
        "src/config.ts",
        "src/runtime/server/*.ts"
      ]
    },
    "packages/admin": {
      "entry": [
        "src/module.ts",
        "src/runtime/pages/*.vue",
        "src/runtime/passkeys*.ts",
        "src/runtime/composables/*.ts",
        "src/runtime/types.ts"
      ],
      "ignore": [
        "src/runtime/crystal-neuo/**"
      ],
      "ignoreDependencies": [
        "nuxt-atelier"
      ]
    },
    "packages/layer": {
      "entry": [
        "app/atelier-admin/*.vue"
      ]
    },
    "docs": {
      "ignoreDependencies": [
        "@takumi-rs/core"
      ],
      "entry": [
        "app/components/content/*.vue",
        "scripts/*.ts"
      ]
    },
    "test/fixtures/types": {
      "ignoreDependencies": [
        "vue-tsc"
      ]
    },
    "test/fixtures/layer-override": {
      "entry": [
        "app/atelier-admin/*.vue"
      ]
    },
    "test/fixtures/schema": {
      "ignoreDependencies": [
        "vue-tsc"
      ],
      "entry": [
        "{,layers/*/}server/atelier/{collections,singletons}/*.ts",
        "{app,server}/type-checks.ts"
      ]
    },
    "test/fixtures/api": {
      "entry": [
        "app/**/*.vue",
        "server/api/**/*.ts",
        "server/atelier/**/*.ts"
      ]
    },
    "test/fixtures/auth": {
      "entry": [
        "server/api/**/*.ts",
        "server/atelier/roles.ts"
      ]
    },
    "test/fixtures/blocks": {
      "entry": [
        "app/**/*.{vue,ts}",
        "layers/base/app/blocks/*.vue",
        "server/**/*.ts"
      ]
    },
    "test/fixtures/blocks-dev": {
      "entry": [
        "app/blocks/*.vue",
        "server/**/*.ts"
      ]
    },
    "test/fixtures/better-auth": {
      "entry": [
        "server/atelier/*.ts"
      ]
    },
    "test/fixtures/passkeys": {
      "entry": [
        "server/api/**/*.ts"
      ]
    },
    "test/fixtures/pending": {
      "entry": [
        "server/atelier/collections/*.ts",
        "server/api/*.ts"
      ]
    },
    "test/fixtures/dev-migrate": {
      "entry": [
        "server/atelier/collections/*.ts"
      ]
    },
    "test/fixtures/workers": {
      "entry": [
        "server/atelier/collections/*.ts",
        "server/api/**/*.ts"
      ]
    },
    "test/fixtures/ui-shared": {
      "entry": [
        "app/**/*.vue",
        "server/**/*.ts"
      ]
    },
    "test/fixtures/ui-nuxt-ui": {
      "entry": [
        "app/**/*.{vue,ts}"
      ]
    },
    "test/fixtures/ui-shadcn": {
      "entry": [
        "app/**/*.{vue,ts}"
      ]
    },
    "test/fixtures/ui-tailwind": {
      "entry": [
        "app/**/*.{vue,ts}"
      ]
    },
    "test/fixtures/ui-css": {
      "entry": [
        "app/**/*.{vue,ts}"
      ]
    },
    "test/fixtures/routing": {
      "entry": [
        "app/**/*.{vue,ts}",
        "server/**/*.ts"
      ]
    },
    "test/fixtures/jobs-presets": {
      "ignoreDependencies": [
        "nuxt"
      ]
    },
    "test/fixtures/plugin-events": {
      "entry": [
        "runtime/*.ts",
        "content/**/*.{ts,vue}"
      ]
    },
    "test/fixtures/plugin-host": {
      "entry": [
        "server/**/*.ts",
        "app/**/*.vue"
      ]
    },
    "test/fixtures/i18n-micro": {
      "entry": [
        "app/components/global/*.vue",
        "server/**/*.ts"
      ]
    },
    "test/fixtures/i18n-nuxtjs": {
      "entry": [
        "app/components/global/*.vue",
        "server/**/*.ts"
      ]
    },
    "test/fixtures/i18n-micro-v5": {
      "ignoreDependencies": [
        "nuxt-i18n-micro"
      ]
    },
    "test/fixtures/admin": {
      "ignoreDependencies": [
        "vue-tsc"
      ],
      "entry": [
        "app/**/*.vue",
        "server/atelier/**/*.ts"
      ]
    }
  },
  "ignoreUnresolved": [
    "#atelier",
    "#atelier-schema",
    "#atelier/server",
    "#atelier-migrations",
    "#atelier-drivers",
    "#atelier-better-auth",
    "#atelier-blocks",
    "#components",
    "#atelier-host-pages",
    "#atelier-admin-icons",
    "#atelier-admin-passkeys"
  ]
}
