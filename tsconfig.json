{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "bun"
    ],
    "paths": {
      "#imports": [
        "./test/admin/stubs/imports.ts"
      ],
      "#atelier/shared/*": [
        "./packages/core/src/runtime/shared/*"
      ],
      "#atelier-admin-pages": [
        "./test/admin/stubs/pages.ts"
      ],
      "#atelier-admin-languages": [
        "./test/admin/stubs/languages.ts"
      ]
    }
  },
  "include": [
    "scripts/**/*.ts",
    "test/**/*.ts",
    "*.config.ts",
    "*.config.mjs"
  ],
  "exclude": [
    "**/*.fixture.ts",
    "test/fixtures/**"
  ]
}
