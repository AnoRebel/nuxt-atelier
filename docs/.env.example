# Analytics for the docs site. Both are off when their id is empty.
# They're read at build time (pages are prerendered): pass them as Docker build args.

# Umami (umami.anorebel.net): the website id from the Umami dashboard
NUXT_UMAMI_SITE_ID=

# Rybbit (rybbit.anorebel.net): the site id from the Rybbit dashboard
NUXT_RYBBIT_SITE_ID=
