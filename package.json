{
  "name": "nuxt-atelier-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "playground",
      "docs",
      "test/fixtures/*"
    ],
    "catalog": {
      "vue": "3.5.44",
      "vue-router": "^5.4.0",
      "@nuxt/kit": "^4.6.3",
      "@nuxt/schema": "4.6.3",
      "nuxt": "4.6.3",
      "valibot": "^1.5.0",
      "jiti": "^2.7.0",
      "oxc-parser": "0.156.0",
      "magic-string": "1.4.5",
      "@vue/compiler-sfc": "3.5.44"
    },
    "catalogs": {
      "i18n": {
        "nuxt-i18n-micro": "3.30.1",
        "@nuxtjs/i18n": "10.6.0"
      },
      "build": {
        "@nuxt/module-builder": "1.0.3",
        "typescript": "6.0.3",
        "@types/bun": "1.4.4",
        "vue-tsc": "3.3.14"
      },
      "quality": {
        "eslint": "10.14.0",
        "@nuxt/eslint-config": "1.17.0",
        "oxlint": "1.90.0",
        "knip": "6.44.0",
        "publint": "0.3.25",
        "@arethetypeswrong/cli": "0.18.5",
        "lint-staged": "17.6.0",
        "simple-git-hooks": "2.14.0",
        "@changesets/cli": "3.0.3"
      },
      "docs": {
        "docus": "5.15.0",
        "@takumi-rs/core": "2.19.0",
        "nuxt-umami": "3.2.1",
        "@videojs/html": "10.3.0"
      },
      "test": {
        "vitest": "5.0.5",
        "@nuxt/test-utils": "4.3.4",
        "miniflare": "4.20260730.0",
        "playwright-core": "1.65.0",
        "@date-fns/tz": "1.5.0",
        "@seriousme/openapi-schema-validator": "2.11.0",
        "axe-core": "4.14.0"
      },
      "ui": {
        "@nuxt/ui": "4.12.0",
        "tailwindcss": "4.3.3",
        "@tailwindcss/vite": "4.3.3",
        "shadcn-nuxt": "2.9.0",
        "reka-ui": "2.11.0",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "tailwind-merge": "3.7.0"
      },
      "auth": {
        "better-auth": "1.7.14",
        "@simplewebauthn/server": "14.0.3",
        "@simplewebauthn/browser": "14.0.0"
      },
      "media": {
        "file-type": "22.3.0",
        "aws4fetch": "1.0.20",
        "@vercel/blob": "2.8.2",
        "sharp": "0.35.5"
      },
      "db": {
        "drizzle-orm": "1.0.0-rc.5",
        "@libsql/client": "^0.18.0",
        "pg": "^8.23.1",
        "mysql2": "^3.24.6",
        "@types/pg": "8.23.1",
        "drizzle-kit": "1.0.0-rc.5"
      },
      "admin": {
        "@tanstack/vue-query": "5.105.0",
        "@tanstack/vue-form": "1.33.5",
        "@iconify-json/lucide": "1.2.148"
      },
      "seo": {
        "@nuxtjs/robots": "7.0.2",
        "@nuxtjs/sitemap": "9.1.0"
      }
    }
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "lint": "oxlint && eslint .",
    "lint:fix": "oxlint --fix && eslint . --fix",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p test/vue-tsc && bun run --filter '@nuxt-atelier/fixture-{types,schema,admin}' typecheck",
    "test": "vitest run",
    "build": "bun run --filter './packages/*' build",
    "check:pkg": "bun run --filter './packages/*' check:pkg",
    "knip": "knip",
    "docs:build": "bun run --filter @nuxt-atelier/docs build",
    "docs:dev": "bun run --filter @nuxt-atelier/docs dev",
    "dev": "bun run --filter @nuxt-atelier/playground dev",
    "docs:config": "bun scripts/config-reference.ts",
    "licenses": "bun scripts/check-licenses.ts",
    "deps": "bun scripts/check-dependencies.ts",
    "pack": "bun scripts/pack.ts",
    "design:sync": "bun scripts/sync-crystal-neuo.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:quality",
    "@changesets/cli": "catalog:quality",
    "@date-fns/tz": "catalog:test",
    "@nuxt/eslint-config": "catalog:quality",
    "@nuxt/kit": "catalog:",
    "@nuxt/module-builder": "catalog:build",
    "@nuxt/test-utils": "catalog:test",
    "@seriousme/openapi-schema-validator": "catalog:test",
    "@tanstack/vue-query": "catalog:admin",
    "@types/bun": "catalog:build",
    "aws4fetch": "catalog:media",
    "axe-core": "catalog:test",
    "better-auth": "catalog:auth",
    "drizzle-kit": "catalog:db",
    "drizzle-orm": "catalog:db",
    "eslint": "catalog:quality",
    "knip": "catalog:quality",
    "lint-staged": "catalog:quality",
    "miniflare": "catalog:test",
    "oxlint": "catalog:quality",
    "playwright-core": "catalog:test",
    "publint": "catalog:quality",
    "sharp": "catalog:media",
    "simple-git-hooks": "catalog:quality",
    "typescript": "catalog:build",
    "valibot": "catalog:",
    "vitest": "catalog:test",
    "vue": "catalog:",
    "vue-tsc": "catalog:build"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged",
    "commit-msg": "bun scripts/check-commit-msg.ts \"$1\""
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,vue}": [
      "oxlint --fix",
      "eslint --fix"
    ],
    "bun.lock": "bun scripts/check-licenses.ts"
  },
  "overrides": {
    "nuxt-og-image": "7.0.7",
    "@nuxtjs/sitemap": "9.1.0",
    "@nuxtjs/robots": "7.0.2",
    "nuxt-schema-org": "7.0.1",
    "nuxt-site-config": "5.0.3",
    "@vercel/cli-config>zod": "4.6.7"
  }
}
