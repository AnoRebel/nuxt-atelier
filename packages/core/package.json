{
  "name": "nuxt-atelier",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnoRebel/nuxt-atelier.git",
    "directory": "packages/core"
  },
  "homepage": "https://nuxt-atelier.anorebel.net",
  "description": "The Nuxt CMS with a visual builder for your own components",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./adapter": {
      "types": "./dist/adapter.d.mts",
      "import": "./dist/adapter.mjs"
    },
    "./storage": {
      "types": "./dist/storage.d.mts",
      "import": "./dist/storage.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ],
      "adapter": [
        "./dist/adapter.d.mts"
      ],
      "storage": [
        "./dist/storage.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nuxt-module-build build",
    "prepack": "nuxt-module-build build",
    "check:pkg": "publint --pack bun && attw --pack . --profile esm-only"
  },
  "peerDependencies": {
    "nuxt": ">=4.6.0",
    "pg": "catalog:db",
    "mysql2": "catalog:db",
    "nodemailer": ">=7.0.0",
    "drizzle-kit": "catalog:db",
    "@simplewebauthn/server": "catalog:auth",
    "sharp": "catalog:media"
  },
  "dependencies": {
    "@tanstack/vue-form": "catalog:admin",
    "@nuxt/kit": "catalog:",
    "valibot": "catalog:",
    "drizzle-orm": "catalog:db",
    "@libsql/client": "catalog:db",
    "jiti": "catalog:",
    "oxc-parser": "catalog:",
    "magic-string": "catalog:",
    "@vue/compiler-sfc": "catalog:",
    "vue-router": "catalog:",
    "file-type": "catalog:media",
    "h3": "^1.15.11"
  },
  "devDependencies": {
    "@nuxt/schema": "catalog:",
    "pg": "catalog:db",
    "mysql2": "catalog:db",
    "@types/pg": "catalog:db",
    "drizzle-kit": "catalog:db",
    "@simplewebauthn/server": "catalog:auth",
    "sharp": "catalog:media"
  },
  "peerDependenciesMeta": {
    "nodemailer": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "drizzle-kit": {
      "optional": true
    },
    "@simplewebauthn/server": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  },
  "bin": {
    "atelier": "./dist/cli/index.mjs"
  }
}
