{
  "name": "@nuxt-atelier/admin",
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnoRebel/nuxt-atelier.git",
    "directory": "packages/admin"
  },
  "homepage": "https://nuxt-atelier.anorebel.net",
  "description": "Headless admin composables and the default admin kit (crystal-neuo) for Nuxt Atelier",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nuxt-module-build build",
    "prepack": "nuxt-module-build build",
    "check:pkg": "publint --pack bun && attw --pack . --profile esm-only"
  },
  "peerDependencies": {
    "nuxt": ">=4.6.0",
    "nuxt-atelier": "workspace:^",
    "@simplewebauthn/browser": "catalog:auth"
  },
  "dependencies": {
    "@nuxt/kit": "catalog:",
    "@tanstack/vue-query": "catalog:admin",
    "@tanstack/vue-form": "catalog:admin",
    "@iconify-json/lucide": "catalog:admin",
    "@tiptap/core": "catalog:editor",
    "@tiptap/pm": "catalog:editor",
    "@tiptap/vue-3": "catalog:editor",
    "@tiptap/starter-kit": "catalog:editor"
  },
  "devDependencies": {
    "@nuxt/schema": "catalog:",
    "nuxt-atelier": "workspace:^",
    "@simplewebauthn/browser": "catalog:auth",
    "vue": "catalog:"
  },
  "peerDependenciesMeta": {
    "@simplewebauthn/browser": {
      "optional": true
    }
  }
}
