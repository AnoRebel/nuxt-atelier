{
  "name": "@nuxt-atelier/ai",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnoRebel/nuxt-atelier.git",
    "directory": "packages/ai"
  },
  "homepage": "https://nuxt-atelier.anorebel.net",
  "description": "Provider-agnostic AI assist adapter for Nuxt Atelier",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nuxt-module-build build",
    "prepack": "nuxt-module-build build",
    "check:pkg": "publint --pack bun && attw --pack . --profile esm-only"
  },
  "peerDependencies": {
    "nuxt": ">=4.6.0"
  },
  "dependencies": {
    "@nuxt/kit": "catalog:"
  },
  "devDependencies": {
    "@nuxt/schema": "catalog:"
  }
}
